{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-gain-basic-standalone",
			"type": "process",
			"command": "cargo",
			"args": [
				"xtask",
				"build",
				"--plugin",
				"gain-basic",
				"--target",
				"standalone"
			],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"close": true
			},
			"problemMatcher": "$rustc"
		},
		{
			"label": "open-gain-basic-standalone",
			"type": "process",
			"command": "cargo",
			"args": [
				"xtask",
				"launch",
				"--plugin",
				"gain-basic"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"close": true
			}
		},
		{
			"label": "build-and-open-gain-basic-standalone",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build-gain-basic-standalone",
				"open-gain-basic-standalone"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"close": true
			}
		},
		{
