				"sine-synth"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new",
				"close": true
			}
		},
		{
			"label": "build-and-open-sine-synth-standalone",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build-sine-synth-standalone",
